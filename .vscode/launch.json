    },
    {
      "name": "Pokédex (Web Server / Opera)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "web-server", "--web-port=8080", "--web-hostname=localhost"]
    }
  ]
